# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL Database Connection (Production europe-west2)
SQL_HOST="127.0.0.1"
SQL_USER="fona_db_user"
SQL_PASSWORD="secure_database_password_here"
SQL_DB_NAME="fona_digital_production"

# Google Cloud Storage (GCS) - Stockage Hors-Site Sécurisé pour les Sauvegardes Chiffrées
GCS_BACKUP_BUCKET="fona-backups-europe-west2-15c1948e31b04"
GCS_BACKUP_REGION="europe-west2"
GCP_PROJECT_ID="ais-europe-west2-15c1948e31b04"

# Google Cloud Secret Manager (GCSM) - Injection de la Clé Maîtresse de Chiffrement AES-256-GCM
# La clé ne doit JAMAIS être inscrite en clair dans le code, Git ou les logs techniques.
GCP_SECRET_NAME_ENCRYPTION_KEY="FONA_BACKUP_ENCRYPTION_KEY"
BACKUP_ENCRYPTION_KEY="valeur_injectee_uniquement_par_secret_manager_ou_runtime_securise"

# Compte de service IAM autorisé (Least Privilege)
AUTHORIZED_SERVICE_ACCOUNT_EMAIL="ais-sandbox@ais-europe-west2-15c1948e31b04.iam.gserviceaccount.com"
